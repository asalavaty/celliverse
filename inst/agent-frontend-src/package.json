{
  "name": "celliverse-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "React + TypeScript frontend for the CelliVerse Agent (shipped inside the celliverse R package).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pkg": "tsc -b && vite build --outDir ../react-app --emptyOutDir",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^24.1.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
